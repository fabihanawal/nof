# GEMINI_API_KEY: Required for Gemini AI API calls (Optional/Feature specific).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Public URL of the hosted application (e.g. https://your-app.vercel.app)
APP_URL="https://your-app.vercel.app"

# OPTIONAL FIREBASE OVERRIDES (If deploying with your own Firebase project on Vercel)
# If left unset, the application automatically uses the embedded firebase-applet-config.json
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_DATABASE_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
